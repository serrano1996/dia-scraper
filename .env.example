# Obligatorias
DIA_BASE_URL=https://www.dia.es
REDIS_URL=redis://localhost:6379/0

# Opcionales (valor por defecto indicado)
# Vida de cada búsqueda cacheada en Redis, en segundos (> 0).
CACHE_TTL_SECONDS=3600
# Intentos en total ante 5xx, 429 o errores de red (> 0). Un 403 de Akamai o un 4xx no se reintentan.
RETRY_MAX_ATTEMPTS=3
# Espera base entre intentos, en segundos (>= 0): 0.5 → 1 → 2… 0 = sin espera.
RETRY_BASE_DELAY=0.5
# Timeout de cada petición a Dia (conexión, lectura, escritura y pool), en segundos (> 0).
HTTP_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO

# Sesiones de Dia, una por código postal (spec 002).
# Se renueva cada sesión pasado este tiempo desde su creación, en segundos (> 0). La cookie de Dia dura 1 h.
SESSION_MAX_AGE_SECONDS=3000
# Sesiones abiertas a la vez (> 0). Al superarlo se descarta la usada hace más tiempo.
MAX_SESSIONS=100
# Cuánto se recuerda que Dia no da servicio en un código postal, en segundos (> 0).
POSTAL_CODE_NEGATIVE_CACHE_TTL_SECONDS=86400

# Protección frente a Akamai (spec 003). Ningún valor es un umbral medido: ajústalos con los WARNING del log.
# Segundos sin llamar a Dia tras un bloqueo de Akamai (> 0). No se alarga con más bloqueos.
AKAMAI_COOLDOWN_SECONDS=300
# Peticiones a Dia por ventana, entre todas las instancias (>= 0). 0 = sin límite.
DIA_RATE_LIMIT=30
# Ventana del límite anterior, en segundos (> 0).
DIA_RATE_WINDOW_SECONDS=60
# Códigos postales nuevos (sesiones de Dia) por ventana (>= 0). 0 = sin límite.
NEW_SESSION_LIMIT=10
# Ventana del límite anterior, en segundos (> 0).
NEW_SESSION_WINDOW_SECONDS=600
# Aleatorio máximo, en segundos, sumado a cada espera entre reintentos (>= 0). 0 = sin aleatorio.
RETRY_JITTER_MAX_S=0.3
