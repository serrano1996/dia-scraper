# Obligatorias
DIA_BASE_URL=https://www.dia.es
REDIS_URL=redis://localhost:6379/0

# Opcionales (valor por defecto indicado)
# Vida de cada búsqueda cacheada en Redis, en segundos (> 0).
CACHE_TTL_SECONDS=3600
# Intentos en total ante 5xx, 429 o errores de red (> 0). Un 403 de Akamai o un 4xx no se reintentan.
RETRY_MAX_ATTEMPTS=3
# Espera base entre intentos, en segundos (>= 0): 0.5 → 1 → 2… 0 = sin espera.
RETRY_BASE_DELAY=0.5
# Timeout de cada petición a Dia (conexión, lectura, escritura y pool), en segundos (> 0).
HTTP_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
